<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Login</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: #f7f7f8;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 40px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            max-width: 320px;
            text-align: center;
        }

        .spinner {
            width: 32px;
            height: 32px;
            border: 3px solid #e5e5e5;
            border-top-color: #4285F4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        p {
            color: #3c4043;
            font-size: 15px;
            line-height: 1.4;
        }

        .error-text {
            color: #d93025;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="card" id="card">
        <div class="spinner"></div>
        <p>Redirecting to Google...</p>
    </div>

    <script>
        (async () => {
            try {
                const response = await fetch("<%= betterAuthUrl %>/api/auth/sign-in/social", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "include",
                    body: JSON.stringify({
                        provider: "google",
                        callbackURL: "<%= callbackURL %>"
                    })
                });
                const data = await response.json();
                if (data.url) {
                    window.location.href = data.url;
                } else {
                    document.getElementById("card").innerHTML =
                        `<p class="error-text">Error occurred while redirecting to Google. Please try again later.</p>`;
                }
            } catch (error) {
                document.getElementById("card").innerHTML =
                    `<p class="error-text">Error occurred while redirecting to Google. Please try again later.<br>${error.message}</p>`;
            }
        })();
    </script>
</body>
</html>