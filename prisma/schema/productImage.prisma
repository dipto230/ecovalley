model ProductImage {
  id         String   @id @default(uuid())
  imageUrl   String

  createdAt  DateTime @default(now())

  // Foreign Key
  productId  String

  // Relation
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId], name: "idx_product_image_product")
  @@map("product_images")
}