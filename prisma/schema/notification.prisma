model Notification {
  id         String   @id @default(uuid())
  customerId String
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("notifications")
}