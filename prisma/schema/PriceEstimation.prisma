model PriceEstimation {
  id               String   @id @default(uuid())
  productId        String

  aiPredictedPrice Decimal  @db.Decimal(10,2)
  averagePrice     Decimal  @db.Decimal(10,2)
  lowestPrice      Decimal  @db.Decimal(10,2)
  highestPrice     Decimal  @db.Decimal(10,2)

  confidenceScore  Float?

  sources          PriceSource[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("price_estimations")
}


model PriceSource {
  id                String   @id @default(uuid())
  priceEstimationId String

  sourceName        String
  productName       String?
  price             Decimal  @db.Decimal(10,2)
  sourceUrl         String?
  scrapedAt         DateTime @default(now())

 priceEstimation PriceEstimation @relation(fields: [priceEstimationId], references: [id], onDelete: Cascade)

  @@index([priceEstimationId])
  @@map("price_sources")
}